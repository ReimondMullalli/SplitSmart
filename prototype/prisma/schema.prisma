generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Lab 8 environment verification model (kept so existing data is preserved).
model EnvironmentCheck {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------
// SplitSmart (Lab 9). All money is stored as integer cents.
// ---------------------------------------------------------------

model Group {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  members   Member[]
  expenses  Expense[]
}

model Member {
  id        Int            @id @default(autoincrement())
  name      String
  groupId   Int
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  paid      Expense[]      @relation("ExpensePayer")
  shares    ExpenseShare[]

  @@unique([groupId, name])
  @@index([groupId])
}

model Expense {
  id          Int            @id @default(autoincrement())
  description String
  amountCents Int
  groupId     Int
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payerId     Int
  payer       Member         @relation("ExpensePayer", fields: [payerId], references: [id])
  createdAt   DateTime       @default(now())
  shares      ExpenseShare[]

  @@index([groupId])
}

// How much of an expense each participant owes. The shares of one
// expense always add up exactly to Expense.amountCents.
model ExpenseShare {
  id         Int     @id @default(autoincrement())
  expenseId  Int
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId   Int
  member     Member  @relation(fields: [memberId], references: [id])
  shareCents Int

  @@unique([expenseId, memberId])
  @@index([memberId])
}
